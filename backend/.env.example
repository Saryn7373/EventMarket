# ============================================
# Backend Environment Variables Example
# Скопируйте этот файл в .env и измените значения
# ============================================

# Django
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION
DEBUG=True

# Database
DB_NAME=eventmarket
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5433

# CORS (URL фронтенда, через запятую без пробелов)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# CORS методы (через запятую без пробелов)
CORS_ALLOW_METHODS=DELETE,GET,OPTIONS,PATCH,POST,PUT

# CORS заголовки (через запятую без пробелов)
CORS_ALLOW_HEADERS=accept,accept-encoding,authorization,content-type,dnt,origin,user-agent,x-csrftoken,x-requested-with

# Allowed Hosts (через запятую без пробелов)
ALLOWED_HOSTS=localhost,127.0.0.1

# Internal IPs (для Django Debug Toolbar)
INTERNAL_IPS=127.0.0.1

# JWT Tokens (в минутах/днях)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=your_email@yandex.ru
EMAIL_HOST_PASSWORD=your_app_password_here
DEFAULT_FROM_EMAIL=EventMarket <your_email@yandex.ru>
